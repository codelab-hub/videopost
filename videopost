#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
JAR_FILE="$DIR/target/videopost-cli-1.0.0-SNAPSHOT.jar"

if [ ! -f "$JAR_FILE" ]; then
    echo "JAR não encontrado. Compilando o projeto..."
    export PATH="$HOME/.maven/apache-maven-3.9.16/bin:$PATH"
    mvn -f "$DIR/pom.xml" clean package -DskipTests
fi

exec java -jar "$JAR_FILE" "$@"
