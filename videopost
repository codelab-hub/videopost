#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
JAR_FILE="$DIR/target/videopost-cli-1.0.0-SNAPSHOT.jar"

NEEDS_BUILD=0
if [ ! -f "$JAR_FILE" ]; then
    NEEDS_BUILD=1
elif [ -d "$DIR/src" ]; then
    # Se algum arquivo .java for mais recente que o JAR, recompila
    CHANGED_COUNT=$(find "$DIR/src" -type f -name "*.java" -newer "$JAR_FILE" 2>/dev/null | wc -l)
    if [ "$CHANGED_COUNT" -gt 0 ]; then
        NEEDS_BUILD=1
    fi
fi

if [ "$NEEDS_BUILD" -eq 1 ]; then
    echo "📦 Atualizando e compilando VideoPost com suporte a YouTube Shorts..."
    export PATH="$HOME/.maven/apache-maven-3.9.16/bin:$PATH"
    if [ -x "$DIR/mvnw" ]; then
        "$DIR/mvnw" -f "$DIR/pom.xml" package -DskipTests
    elif command -v mvn >/dev/null 2>&1; then
        mvn -f "$DIR/pom.xml" package -DskipTests
    else
        echo "❌ Erro: Maven não encontrado. Instale o Maven ou execute com ./mvnw"
        exit 1
    fi
fi

exec java -jar "$JAR_FILE" "$@"
